{
  "name": "n8n-nodes-agentsearch",
  "version": "0.4.0",
  "author": {
    "name": "AgentSearch",
    "email": "AgentSearchhq@gmail.com",
    "url": "https://agentsearchhq.com"
  },
  "description": "n8n community node for AgentSearch: free live web search for AI agents (no credentials), plus page Extract and JavaScript Render at $0.005 per call (USDC on Base via x402)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "agentsearch",
    "web-search",
    "search",
    "ai-agent",
    "extract",
    "web-scraping",
    "x402"
  ],
  "license": "MIT",
  "homepage": "https://agentsearchhq.com/?utm_source=n8n-nodes-agentsearch&utm_medium=package",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/AgentSearch/*.svg dist/nodes/AgentSearch/ && cp credentials/*.svg dist/credentials/",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AgentSearchWalletApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AgentSearch/AgentSearch.node.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsearchhq-coder/n8n-nodes-agentsearch.git"
  },
  "bugs": {
    "url": "https://github.com/agentsearchhq-coder/n8n-nodes-agentsearch/issues"
  }
}
